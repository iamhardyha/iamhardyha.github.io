---
import PostMeta from './PostMeta.astro';
import { readingTime } from '../utils/reading-time';
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const minutes = readingTime(post.body ?? '');
---
<article class="card">
  <a href={`/posts/${post.id}`} class="card__link">
    <h3 class="card__title">{post.data.title}</h3>
    <p class="card__desc">{post.data.description}</p>
  </a>
  <PostMeta pubDate={post.data.pubDate} minutes={minutes} tags={post.data.tags} />
</article>
<style>
  .card { padding: 26px 0; border-bottom: 1px solid var(--border); }
  .card__link { display: block; }
  .card__title {
    font-family: var(--serif); font-size: 1.5rem; line-height: 1.3;
    margin: 0 0 8px; color: var(--text); transition: color 0.15s ease;
  }
  .card__link:hover .card__title { color: var(--accent); }
  .card__desc {
    color: var(--text-muted); font-size: 1.02rem; line-height: 1.5; margin: 0 0 12px;
  }
  @media (max-width: 640px) {
    .card__title { font-size: 1.35rem; }
  }
</style>
