---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404">
  <div class="container nf">
    <h1 class="nf__code">404</h1>
    <p class="nf__msg">찾으시는 글이 없습니다.</p>
    <a href="/" class="nf__home"><span aria-hidden="true">←</span> 홈으로</a>
  </div>
</BaseLayout>

<style>
  .nf { text-align: center; padding: 120px 0; }
  .nf__code { font-family: var(--serif); font-size: 5rem; line-height: 1; margin: 0; letter-spacing: -0.02em; color: var(--text); }
  .nf__msg { color: var(--text-muted); font-size: 1.1rem; margin: 20px 0 28px; }
  .nf__home {
    display: inline-flex; align-items: center; gap: 6px;
    border: 1px solid var(--border); border-radius: 999px; padding: 10px 20px;
    font-weight: 600; color: var(--text);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .nf__home:hover { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 640px) { .nf { padding: 80px 0; } .nf__code { font-size: 3.6rem; } }
</style>
