---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const projects = [
  {
    title: 'Pocket Senior',
    desc: '출퇴근길에 읽는 백엔드 개발 미니북',
    href: 'https://iamhardyha.github.io/pocket-senior/',
    badge: 'PROJECT',
  },
  {
    title: '티스토리 블로그',
    desc: '기술 블로그 보러가기',
    href: 'https://devhardy.tistory.com/',
    badge: 'BLOG',
  },
];
---
<BaseLayout title="Projects">
  <div class="container">
    <PageHeader title="Projects" subtitle="만들고 있는 것들" />
    <div class="proj-list">
      {projects.map((p) => (
        <a class="proj" href={p.href} target="_blank" rel="noopener">
          <div>
            <span class="proj__badge">{p.badge}</span>
            <h3 class="proj__title">{p.title}</h3>
            <p class="proj__desc">{p.desc}</p>
          </div>
          <span class="proj__arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .proj-list { display: flex; flex-direction: column; gap: 14px; padding: 28px 0 40px; }
  .proj {
    display: flex; justify-content: space-between; align-items: center; gap: 20px;
    border: 1px solid var(--border); border-radius: 12px; padding: 24px; color: var(--text);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .proj:hover {
    border-color: var(--accent); transform: translateY(-1px);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .proj__badge {
    color: var(--accent); font-size: 0.72rem; letter-spacing: 0.12em;
    text-transform: uppercase; font-weight: 700;
  }
  .proj__title { font-family: var(--serif); font-size: 1.4rem; margin: 8px 0 4px; color: var(--text); }
  .proj__desc { color: var(--text-muted); margin: 0; }
  .proj__arrow {
    font-size: 1.3rem; color: var(--text-muted); flex: none;
    transition: transform 0.2s ease, color 0.15s ease;
  }
  .proj:hover .proj__arrow { transform: translateX(4px); color: var(--accent); }
  @media (prefers-reduced-motion: reduce) {
    .proj, .proj__arrow { transition: none; }
    .proj:hover { transform: none; }
    .proj:hover .proj__arrow { transform: none; }
  }
</style>
