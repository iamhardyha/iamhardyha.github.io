---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { collectTags } from '../../utils/posts';

const tags = collectTags(await getCollection('posts'));
---
<BaseLayout title="Topics">
  <div class="container">
    <PageHeader title="Topics" subtitle="주제별로 모아 보기" />
    <ul class="tag-cloud">
      {tags.map(({ tag, count }) => (
        <li><a href={`/topics/${encodeURIComponent(tag)}`}>{tag} <span>{count}</span></a></li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .tag-cloud { list-style: none; padding: 0; margin: 28px 0 40px; display: flex; flex-wrap: wrap; gap: 10px; }
  .tag-cloud a {
    display: inline-flex; align-items: center; gap: 7px;
    border: 1px solid var(--border); border-radius: 999px; padding: 8px 16px;
    color: var(--text); font-size: 0.95rem;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .tag-cloud a:hover {
    border-color: var(--accent); color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg));
  }
  .tag-cloud span { color: var(--text-muted); font-size: 0.8rem; }
  .tag-cloud a:hover span { color: var(--accent); }
</style>
