---
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import Comments from '../components/Comments.astro';
import { readingTime } from '../utils/reading-time';
import '../styles/prose.css';
import type { CollectionEntry } from 'astro:content';

interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { title, description, pubDate, tags, cover, series } = post.data;
const minutes = readingTime(post.body ?? '');
---
<BaseLayout title={title} description={description} image={cover} article={true}>
  <header class:list={["post-header", { 'post-header--cover': cover }]} style={cover ? `background-image:url(${cover})` : ''}>
    <div class="container post-header__inner">
      {series && <a class="post-header__kicker" href={`/series/${encodeURIComponent(series)}`}>📚 {series}</a>}
      <h1 class="post-header__title">{title}</h1>
      {description && <p class="post-header__lead">{description}</p>}
      <PostMeta pubDate={pubDate} minutes={minutes} tags={tags} />
    </div>
  </header>
  <article class="container post-content" data-pagefind-body>
    <div class="prose">
      <slot />
    </div>
  </article>
  <div class="container">
    <Comments />
  </div>
</BaseLayout>

<style>
  .post-header { padding: 56px 0 0; }
  .post-header--cover { background-size: cover; background-position: center; padding: 120px 0 0; position: relative; }
  .post-header--cover::after { content:""; position:absolute; inset:0; background: linear-gradient(to bottom, var(--scrim), var(--bg) 95%); }
  /* Divider hierarchy on the post page (deliberate, three tiers):
       1. nav / footer  → full-width hairline (page chrome)
       2. header ↔ body, body ↔ comments → column-width hairline (section boundary, here)
       3. in-article `---` → three-dot asterism (content pause, see prose.css)
     Same weight is reused only for the same role, so no two boundaries read as a
     doubled-up line. This hairline follows the content column, not the viewport. */
  .post-header__inner { position: relative; z-index: 1; padding-bottom: 36px; border-bottom: 1px solid var(--border); }
  /* Breathing room between the divider and the article body */
  .post-content { padding-top: 48px; }

  .post-header__kicker {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--accent); font-size: 0.82rem; font-weight: 600; margin-bottom: 16px;
  }
  .post-header__title {
    font-family: var(--serif); font-size: 2.6rem; line-height: 1.18;
    letter-spacing: -0.01em; margin: 0 0 18px; color: var(--text);
    text-wrap: balance; word-break: keep-all;
  }
  .post-header__lead {
    font-family: var(--serif); font-size: 1.3rem; line-height: 1.55;
    font-style: italic; color: var(--text-muted); margin: 0 0 28px;
    text-wrap: pretty; word-break: keep-all;
  }
  @media (max-width: 640px) {
    .post-header { padding: 40px 0 0; }
    .post-header__inner { padding-bottom: 24px; }
    .post-content { padding-top: 32px; }
    .post-header__title { font-size: 1.9rem; }
    .post-header__lead { font-size: 1.1rem; }
  }
</style>
